# Public app URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project values — safe to expose only these public values
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Server-only. Never prefix with NEXT_PUBLIC_. Keep this private.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# One-time bootstrap secret; configure only in private deployment secrets.
INITIAL_OWNER_BOOTSTRAP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
